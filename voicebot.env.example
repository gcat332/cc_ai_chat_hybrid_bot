# Copy to voicebot.env (never commit it) and fill in. tools/run_voicebot_demo.sh reads it.
AUDIO_CONNECTOR_API_KEY=     # long random string (openssl rand -hex 32); the same value goes into Genesys
AZURE_SPEECH_KEY=            # Azure portal -> Speech resource -> Keys and Endpoint
AZURE_SPEECH_REGION=southeastasia
# Optional
AZURE_SPEECH_VOICE=th-TH-PremwadeeNeural
AZURE_SPEECH_RATE=0%
PORT=8080
